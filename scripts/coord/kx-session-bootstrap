#!/bin/bash
# kx-session-bootstrap — first action of every Kronaxis session.
#
# Arms cross-session coord listener, verifies fabric is up, surfaces yesterday's
# memos for this session, and registers presence so peers can see who's alive.
#
# Usage:
#   kx-session-bootstrap <session_name>
#
# Example:
#   kx-session-bootstrap voice
#
# Side effects:
#   - tails kx-coord-listen --filter <session> to /tmp/coord-<session>.log
#   - writes ~/.kx-session/<session>.pid
#   - writes ~/.kx-session/<session>.last-seen (epoch) for kx-coord-pending
#
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: kx-session-bootstrap <session_name>" >&2
  exit 2
fi

SESSION="$1"
STATE_DIR="${HOME}/.kx-session"
mkdir -p "$STATE_DIR"
# Per-shell-session-id state so N concurrent sessions on one host don't clobber
# each other. sid is the controlling-terminal session id of THIS shell — every
# Claude Code instance has its own pty so its own sid.
SID=$(ps -o sid= -p $$ | tr -d ' ')
echo "$SESSION" > "${STATE_DIR}/sid-${SID}.name"
# Back-compat: still write 'current' for any legacy reader (deprecated).
echo "$SESSION" > "${STATE_DIR}/current"
LOG_FILE="/tmp/coord-${SESSION}.log"
PID_FILE="${STATE_DIR}/${SESSION}.pid"
LAST_SEEN_FILE="${STATE_DIR}/${SESSION}.last-seen"

FABRIC_URL="${FABRIC_URL:-http://192.168.50.129:8201}"
FABRIC_KEY="${FABRIC_KEY:-test-key-1}"

echo "=== kx-session-bootstrap: $SESSION ==="

# 1) Kill any prior listener under this name so we don't double-tail.
if [ -f "$PID_FILE" ]; then
  OLD_PID=$(cat "$PID_FILE" 2>/dev/null || echo "")
  if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
    kill "$OLD_PID" 2>/dev/null || true
    sleep 0.2
  fi
fi

# 2) Arm coord listener filtered on this session. Background, log to file.
nohup ~/bin/kx-coord-listen --filter "$SESSION" --pretty \
  >> "$LOG_FILE" 2>&1 &
echo $! > "$PID_FILE"
echo "[bootstrap] coord listener armed (pid=$(cat $PID_FILE), log=$LOG_FILE)"

# 3) Init last-seen now so kx-coord-pending only shows new messages from now on.
date -u +%s > "$LAST_SEEN_FILE"

# 4) Verify fabric is alive.
if ! curl -fsS -m 3 -H "Authorization: Bearer $FABRIC_KEY" \
     "$FABRIC_URL/v1/health" >/dev/null 2>&1; then
  echo "[bootstrap] FABRIC DOWN — investigate before proceeding (URL=$FABRIC_URL)"
  exit 3
fi
echo "[bootstrap] fabric OK ($FABRIC_URL)"

# 5) Pull last-known state for this session topic so we don't restart cold.
echo "[bootstrap] recent memos relevant to '$SESSION':"
RESPONSE=$(curl -fsS -m 5 -X POST \
  -H "Authorization: Bearer $FABRIC_KEY" \
  -H "Content-Type: application/json" \
  -d "{\"query\":\"$SESSION last-state\",\"top_k\":3,\"mode\":\"hybrid\"}" \
  "$FABRIC_URL/v1/memo/search" 2>/dev/null || echo '{"results":[]}')
echo "$RESPONSE" | python3 -c "
import sys, json
try:
    r = json.load(sys.stdin)
    for m in r.get('results', [])[:3]:
        title = m.get('title','')[:120]
        score = m.get('score', 0)
        print(f'  #{m[\"id\"]}  score {score:.2f}  {title}')
except Exception as e:
    print(f'  (memo parse error: {e})')
"

# 5.5) PRINT GOLDEN RULES into session context. Hard-floor (always) + topic match.
# Source: tenant_00000000.memos rows tagged version:2026-06-06-46rules.
# Hard-floor: tag 'hard-floor' (always print).
# Topic match: any topic:<x> tag where session-name shares a substring with <x>.
# Falls back silently if psql/PG creds are absent — the slim CLAUDE.md carries the
# hard floor inline as a fabric-down belt-and-braces.
KX_PG_HOST="${KX_PG_HOST:-192.168.50.129}"
KX_PG_USER="${KX_PG_USER:-titan}"
KX_PG_DB="${KX_PG_DB:-tfs}"
KX_PG_PASS="${KX_PG_PASS:-${TFS_DB_PASSWORD:-sovereign_hardened_2026}}"
RULES_VERSION_TAG="version:2026-06-06-46rules"
LOW_SESSION="$(echo "$SESSION" | tr '[:upper:]' '[:lower:]')"

if command -v psql >/dev/null 2>&1; then
  # Use string_agg with sentinel separator so multi-line `content` round-trips cleanly.
  RULE_SEP=$'\n\n----------------------------------------------------------------\n\n'
  HARDFLOOR_TEXT="$(PGPASSWORD="$KX_PG_PASS" psql -h "$KX_PG_HOST" -U "$KX_PG_USER" -d "$KX_PG_DB" -t -A -c "
    WITH rules AS (
      SELECT (regexp_replace(title, '^Golden Rule (\d+).*', '\1'))::int AS rnum, content
      FROM tenant_00000000.memos
      WHERE '${RULES_VERSION_TAG}' = ANY(tags)
        AND 'hard-floor' = ANY(tags)
        AND title LIKE 'Golden Rule %'
    )
    SELECT string_agg(content, E'\n\n----------------------------------------------------------------\n\n' ORDER BY rnum)
    FROM rules;
  " 2>/dev/null || echo "")"

  TOPIC_TEXT="$(PGPASSWORD="$KX_PG_PASS" psql -h "$KX_PG_HOST" -U "$KX_PG_USER" -d "$KX_PG_DB" -t -A -c "
    WITH rules AS (
      SELECT (regexp_replace(title, '^Golden Rule (\d+).*', '\1'))::int AS rnum, content
      FROM tenant_00000000.memos
      WHERE '${RULES_VERSION_TAG}' = ANY(tags)
        AND NOT ('hard-floor' = ANY(tags))
        AND title LIKE 'Golden Rule %'
        AND EXISTS (
          SELECT 1 FROM unnest(tags) AS t
          WHERE t LIKE 'topic:%'
            AND position(substring(t from 7) in '${LOW_SESSION}') > 0
        )
    )
    SELECT string_agg(content, E'\n\n----------------------------------------------------------------\n\n' ORDER BY rnum)
    FROM rules;
  " 2>/dev/null || echo "")"

  if [ -n "$HARDFLOOR_TEXT" ]; then
    echo ""
    echo "================================================================"
    echo "GOLDEN RULES — HARD FLOOR (always in context, fabric ${RULES_VERSION_TAG})"
    echo "================================================================"
    echo "$HARDFLOOR_TEXT"
  else
    echo "[bootstrap] WARN: could not load hard-floor rules from fabric DB"
  fi

  if [ -n "$TOPIC_TEXT" ]; then
    echo ""
    echo "================================================================"
    echo "GOLDEN RULES — TOPIC MATCH for session '$SESSION'"
    echo "================================================================"
    echo "$TOPIC_TEXT"
  else
    echo "[bootstrap] no topic-rule matches for session '$SESSION' (hard-floor still applied)"
  fi
else
  echo "[bootstrap] WARN: psql not available — relying on CLAUDE.md inline hard-floor"
fi

# 6) Show any unread coord backlog directed at us.
BACKLOG=$(~/bin/kx-coord-pending --recipient "$SESSION" --no-update 2>/dev/null || echo "")
if [ -n "$BACKLOG" ]; then
  echo "[bootstrap] unread coord for $SESSION:"
  echo "$BACKLOG" | sed 's/^/  /'
else
  echo "[bootstrap] no unread coord for $SESSION"
fi

echo "[bootstrap] ready — session $SESSION registered"

# 7) PUSH-WAITER — print the arm instructions for the agent to invoke as its
#    own run_in_background Bash tool call. Per coord-protocol GR §46 every
#    session arms a push-waiter immediately after bootstrap and re-arms on
#    each fire; the UserPromptSubmit pull-hook stays as the backstop.
PUSH_ARM_BIN="$(command -v kx-coord-push-arm 2>/dev/null || true)"
[ -z "$PUSH_ARM_BIN" ] && [ -x "$HOME/bin/kx-coord-push-arm" ] && PUSH_ARM_BIN="$HOME/bin/kx-coord-push-arm"
SCRIPT_DIR_GUESS="$(dirname "$(readlink -f "$0")")"
[ -z "$PUSH_ARM_BIN" ] && [ -x "$SCRIPT_DIR_GUESS/kx-coord-push-arm" ] && PUSH_ARM_BIN="$SCRIPT_DIR_GUESS/kx-coord-push-arm"

if [ -n "$PUSH_ARM_BIN" ]; then
  echo ""
  echo "================================================================"
  echo "ARM YOUR COORD PUSH-WAITER NOW (Golden Rule §46)"
  echo "================================================================"
  "$PUSH_ARM_BIN" "$SESSION"
  echo "================================================================"
  echo ""
else
  echo "[bootstrap] WARN: kx-coord-push-arm not found; install it and re-bootstrap."
fi
