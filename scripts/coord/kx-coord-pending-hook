#!/bin/bash
# kx-coord-pending-hook — safe wrapper for userPromptSubmitHook.
#
# Per-shell-session lookup: each Claude session runs in its own pty so its
# own `getsid` value is unique even on a host with N concurrent sessions.
# Bootstrap writes ~/.kx-session/sid-<SID>.name; this hook reads the same.
#
# Falls back to ~/.kx-session/current for sessions bootstrapped under the
# old shared-file scheme. Silent no-op if nothing is registered.
#
# Never blocks the user's prompt — hard 3s timeout on the drain.

STATE_DIR="${HOME}/.kx-session"
SID=$(ps -o sid= -p $$ | tr -d ' ')
SID_FILE="${STATE_DIR}/sid-${SID}.name"
LEGACY_FILE="${STATE_DIR}/current"

SESSION=""
if [ -f "$SID_FILE" ]; then
  SESSION=$(cat "$SID_FILE" 2>/dev/null | head -1 | tr -d '[:space:]')
elif [ -f "$LEGACY_FILE" ]; then
  SESSION=$(cat "$LEGACY_FILE" 2>/dev/null | head -1 | tr -d '[:space:]')
fi

if [ -z "$SESSION" ]; then
  exit 0
fi

if [ ! -x "${HOME}/bin/kx-coord-pending" ]; then
  exit 0
fi

timeout 3 "${HOME}/bin/kx-coord-pending" --recipient "$SESSION" 2>/dev/null || true
exit 0
